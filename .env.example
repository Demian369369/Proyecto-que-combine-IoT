# Copia este archivo a .env y rellena los valores reales
# .env NO debe subirse al repositorio (ya esta en .gitignore)

FLASK_ENV=development
SECRET_KEY=cambia-esta-clave-por-una-segura

# Umbrales de alerta
TEMP_ALERT_THRESHOLD=30.0
HUMIDITY_ALERT_HIGH=80.0
HUMIDITY_ALERT_LOW=20.0

# Firebase Realtime Database (opcional)
# Descarga tu serviceAccountKey.json desde Firebase Console
# -> Configuracion del proyecto -> Cuentas de servicio -> Generar nueva clave privada
FIREBASE_CREDENTIALS=./firebase-credentials.json
FIREBASE_DB_URL=https://tu-proyecto-default-rtdb.firebaseio.com
